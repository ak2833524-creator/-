    <Cell ss:StyleID="Header"><Data ss:Type="String">담당 어르신수</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">주요 담당 어르신(중점돌봄)</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">어르신 최근 특이사항 보고</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">특이사항 상태</Data></Cell>
    <Cell ss:StyleID="Header"><Data ss:Type="String">당월 휴가일정 및 사유</Data></Cell>
